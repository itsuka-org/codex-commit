{
  "compilerOptions": {
    "module": "Node20",
    "target": "ES2023",
    "outDir": "out",
    "lib": [
      "ES2023"
    ],
    "sourceMap": false,
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "node",
      "mocha"
    ],
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out"
  ]
}
